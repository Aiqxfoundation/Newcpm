{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "exec node $([ -f artifacts/bitnoir-presale/node_modules/vite/bin/vite.js ] && echo artifacts/bitnoir-presale/node_modules/vite/bin/vite.js || echo node_modules/vite/bin/vite.js) --config artifacts/bitnoir-presale/vite.config.ts --host 0.0.0.0 --port 3000",
    "build": "npm run build --workspace=@workspace/bitnoir-presale",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && tsc -p artifacts/bitnoir-presale/tsconfig.json --noEmit",
    "lint": "tsc --build && tsc -p artifacts/bitnoir-presale/tsconfig.json --noEmit"
  },
  "private": true,
  "dependencies": {
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-coinbase": "^0.1.24",
    "@solana/wallet-adapter-phantom": "^0.9.30",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/wallet-adapter-solflare": "^0.6.34",
    "@solana/wallet-adapter-trust": "^0.1.18",
    "@solana/web3.js": "1.99.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  },
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ],
  "overrides": {
    "proxy-addr": "^2.0.8",
    "source-map-js": "^1.2.2",
    "fast-uri": "^3.1.8",
    "brace-expansion": "^5.0.12",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2"
  }
}
